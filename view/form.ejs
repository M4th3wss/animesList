<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="../style.css">
</head>

<body>
    <div class="grid">
        <form class='add-anime-form' action="/add" method="POST">
            <div class="add-name">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" required>
            </div>
            <div class="add-description">
                <label for="describtion">Description:</label>
                <textarea id="describtion" name="describtion" required></textarea>
            </div>
            <div class="add-imgurl">
                <label for="imgurl">Image URL:</label>
                <input type="url" id="imgurl" name="imgurl" required>
            </div>
            <div class="add-imdb">
                <label for="imdb">IMDb Rating:</label>
                <input type="number" id="imdb" name="imdb" step="0.1" min="0" max="10" required>
            </div>
            <div class="add-myscore">
                <label for="myscore">My Rating:</label>
                <input type="number" id="myscore" name="myscore" step="0.1" min="0" max="10" required>
            </div>
            <button class='btn' type="submit">Add Anime</button>
        </form>
    </div>
</body>

